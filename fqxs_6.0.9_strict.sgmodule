^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/stats\/batch\/? data-type=text data="{\"code\":\"20000\",\"data\":\"\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/(?:sf3|sf6)-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/(?:renderer\/package\.json|build\/renderer\/[^\/?#]+\/(?:index\.html|index\.js|fallback\.js|vendors~lp-sdk\.js)) data-type=text data="" status-code=204 header="Content-Type:application/javascript"
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/play-comp\/.* data-type=text data="" status-code=204 header="Content-Type:application/javascript"
^https?:\/\/mon\.zijieapi\.com\/monitor\/collect\/c\/cloudcontrol\/get\/ data-type=text data="{\"data\":\"\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ data-type=text data="{\"data\":{},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"

# 离线广告模板置空。严格版覆盖广告关键词模板，但不整域置空 reading/fqnovelstatic。
^https?:\/\/reading\.snssdk\.com\/reading_offline\/.*(?:ad|ads|csj|pangolin|pangle|bdad|splash|reward|rewarded|monetize|commerce|ecom).*\/(?:template\.js|app-service\.js|prefetch\.js) data-type=text data="" status-code=204 header="Content-Type:application/javascript"
