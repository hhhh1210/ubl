^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/settings\/? data-type=text data="{\"code\":\"20000\",\"data\":{\"init_enable\":false,\"ad_enable\":false,\"enable\":false,\"settings\":{},\"ad_id\":{},\"rit\":{},\"slots\":[],\"placements\":[],\"extra_settings\":{\"init_enable\":false,\"use_pangle_plugin\":false,\"enable_feed_no_ad\":true}}}" status-code=200 header="Content-Type:application/json"
