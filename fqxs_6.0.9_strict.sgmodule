[URL Rewrite]
# 关键 Pangle/字节广告链路改由下方 Script 做 zgyd 式本机断网；这里保留素材与回退 SDK 的普通拒绝兜底。
# HAR 直接命中的 Pangle SDK 设置/统计与常见广告请求。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/material\/check\/? - reject
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/app_log\/? - reject
# stats/batch 用 Map Local 返回成功空响应，不在 Rewrite 硬拒绝，减少 SDK 重试。
^https?:\/\/ad\.zijieapi\.com\/ - reject
^https?:\/\/ads(?:[35]-normal(?:-[a-z]{2})?)?\.zijieapi\.com\/ - reject
^https?:\/\/pangolin(?:16)?\.snssdk\.com\/ - reject
^https?:\/\/(?:sf3|sf6)-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/(?:renderer\/package\.json|build\/renderer\/[^\/?#]+\/(?:index\.html|index\.js|fallback\.js|vendors~lp-sdk\.js)) - reject
^https?:\/\/[^\/]+\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/play-comp\/ - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ - reject
^https?:\/\/[^\/]+\.douyinpic\.com\/ - reject
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ - reject
^https?:\/\/toblog\.ctobsnssdk\.com\/service\/2\/(?:log_settings|device_register|device_register_only|app_alert_check)\/ - reject
^https?:\/\/mssdk\.(?:zijieapi|snssdk|bytedance)\.com\/ - reject
# mon cloudcontrol 用 Map Local 返回空云控，不在 Rewrite 硬拒绝。

# IPA 6.0.9 离线/动态资源严格规则：命中广告、开屏、激励、Pangle、CSJ、BDAD、monetize 等关键词才处理，不整域拦 reading.snssdk.com/fqnovelstatic。
^https?:\/\/reading\.snssdk\.com\/reading_offline\/.*(?:ad|ads|csj|pangolin|pangle|bdad|splash|reward|rewarded|monetize|commerce|ecom|template).* - reject
^https?:\/\/lf-fe\.fqnovelstatic\.com\/obj\/novel-fanqie-fe\/novel-dragon\/feoffline\/.*(?:ad|ads|csj|pangolin|pangle|bdad|splash|reward|rewarded|monetize|commerce|ecom|template).* - reject
^https?:\/\/(?:lf-sourcecdn-tos\.bytegecko\.com|lf-sourcecdn-tos\.bytegoofy\.com|tosv\.byted\.org)\/.*(?:CSJ|csj|BDA|bdad|pangle|pangolin|splash|reward|rewarded|ad-|_ad|monetize).* - reject

# 常见回退 SDK 请求。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/(?:univ|logBatch) - reject
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg - reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch - reject
^https?:\/\/sdk\.e\.qq\.com\/ola\/v2 - reject
^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config|req_ad|notice) - reject
^https?:\/\/cdn\.1rtb\.com\/ - reject
