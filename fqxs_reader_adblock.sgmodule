[URL Rewrite]
# Pangle 广告获取和可玩广告素材。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|material\/check|app_log)\/? - reject
^https?:\/\/(?:sf3|sf6)-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ - reject

# 开屏/激励容灾 SDK 请求和素材。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/(?:univ|logBatch) - reject
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg - reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch - reject
^https?:\/\/sdk\.e\.qq\.com\/ola\/v2 - reject
^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config|req_ad|notice) - reject
^https?:\/\/cdn\.1rtb\.com\/ - reject
^https?:\/\/bgg\.baidu\.com\/bgg\/produce - reject
^https?:\/\/feed-image\.baidu\.com\/ - reject
^https?:\/\/api\.qttunion\.com\/v5\/json - reject
^https?:\/\/service\.qttunion\.com\/qmcd\/get - reject
^https?:\/\/cpc-service-square\.aiclk\.com\/v1\/getConfig - reject
^https?:\/\/logrcv\.aiclk\.com\/ - reject
^https?:\/\/tracelog-debug\.aiclk\.com\/ - reject
^https?:\/\/sdk\.zhangyuyidong\.cn\/(?:api\/zysdk|sdk\/config) - reject
^https?:\/\/sdk-log\.partner\.sm\.cn\/sdk_log - reject
^https?:\/\/qh-material\.taobao\.com\/ - reject
^https?:\/\/atoken\.m\.taobao\.com\/ - reject
^https?:\/\/usr-api\.1sapp\.com\/report\/v1 - reject

# 字节广告和小游戏容灾主机。
^https?:\/\/(?:ad|ads|ads3-normal(?:-[a-z]{2})?|ads5-normal(?:-[a-z]{2})?)\.zijieapi\.com\/ - reject
^https?:\/\/minigame(?:[35]-normal(?:-[a-z]{2})?)?\.zijieapi\.com\/ - reject

# 阅读器动态广告/小游戏卡模板。只处理明确广告路径，不影响普通阅读资源。
^https?:\/\/reading(?:-(?:hl|lq))?\.snssdk\.com\/reading_offline\/.*(?:splash|reader[_-]?ad|reading[_-]?chapter[_-]?ad|chapter[_-]?end[_-]?ad|feed[_-]?ad|reward[_-]?ad|drlynx_monetize_game).* - reject
^https?:\/\/lf-fe\.fqnovelstatic\.com\/obj\/novel-fanqie-fe\/novel-dragon\/feoffline\/.*(?:splash|reader[_-]?ad|reading[_-]?chapter[_-]?ad|chapter[_-]?end[_-]?ad|feed[_-]?ad|reward[_-]?ad|drlynx_monetize_game).* - reject
^https?:\/\/(?:lf-(?:dy-)?sourcecdn-tos\.bytegecko\.com|lf-sourcecdn-tos\.bytegoofy\.com|tosv\.byted\.org)\/.*(?:CSJ|csj|BDA|bdad|pangle|pangolin|splash|reward|rewarded|ad-|_ad|monetize).* - reject
^https?:\/\/lf3-reading\.fqnovelpic\.com\/obj\/novel-common\/img_reader_offline_ad_image\.png - reject

# 捕获模式会以 * MITM 触发 QUIC 回退；普通模式只接管 IPA 明确的 Gecko 路由，且仅拒绝广告通道名。
^https?:\/\/gecko(?:3|5)?\.zijieapi\.com\/.*(?:drlynx_monetize_game|reading_ad_lynx|novel_ad_config).* - reject

[Map Local]
# 7.2.9 IPA 的 drlynx_monetize_game/game-popular-play-card 明确 POST 此接口，
# 并仅从 container_data.section_data 生成“人气游戏推荐”和 GameAdData 广告卡。
# 同时覆盖 reading 原始主机与 TNC 改写后的 fqnovel 主机，返回成功空列表以避免缓存回退。
^https?:\/\/(?:(?:reading(?:-(?:hl|lq))?\.snssdk\.com)|(?:api(?:-(?:hl|lq)|[35]-normal(?:-[a-z]{2})?|5-normal-sinfonline[ab])?\.fqnovel\.com))\/reading\/commerceapi\/commerce\/tab\/v1\/?(?:\?.*)?$ data-type=text data="{\"code\":0,\"err_no\":0,\"message\":\"success\",\"data\":null,\"container_data\":{\"section_data\":[]}}" status-code=200 header="Content-Type:application/json"

# Pangle 返回“无广告”，避免硬失败后继续读取 SDK 缓存。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/settings\/? data-type=text data="{\"code\":\"20000\",\"data\":{\"init_enable\":false,\"ad_enable\":false,\"enable\":false,\"settings\":{},\"slots\":[],\"placements\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/? data-type=text data="{\"request_id\":\"surge-no-ad\",\"status_code\":20001,\"reason\":141,\"desc\":\"no ad\",\"data\":null,\"ads\":[]}" status-code=200 header="Content-Type:application/json"
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/univ data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"impAdInfo\":\"\",\"extra\":\"\",\"adGlobalConfigInfo\":\"\",\"hasAd\":false}" status-code=200 header="Content-Type:application/json"
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/logBatch data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"interval\":3600}" status-code=200 header="Content-Type:application/json"
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg data-type=text data="{\"ret\":0,\"msg\":\"\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
# 阅读 AB 与“看视频免广告”数据源。覆盖 TNC 的 api-hl/api-lq 和 api3/api5 区域节点。
^https?:\/\/api(?:-(?:hl|lq)|[35]-normal(?:-[a-z]{2})?|5-normal-sinfonline[ab])?\.fqnovel\.com\/reading\/ugc\/ab\/config\/v[^\/?#]+ data-type=text data="{\"code\":0,\"message\":\"success\",\"data\":{\"ab_config\":{},\"configs\":{},\"settings\":{},\"novel_ad_config\":{\"enable\":false,\"has_ad\":false,\"ad_enable\":false,\"read_ad_enable\":false,\"video_ad_enable\":false,\"feed_ad_enable\":false},\"NOVEL_AD_CONFIG\":{\"enable\":false,\"has_ad\":false,\"ad_enable\":false,\"read_ad_enable\":false,\"video_ad_enable\":false,\"feed_ad_enable\":false}}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(?:-(?:hl|lq)|[35]-normal(?:-[a-z]{2})?|5-normal-sinfonline[ab])?\.fqnovel\.com\/luckycat\/(?:novel|novel_fm)\/v1\/task\/(?:get_single_ad_info|get_excitation_info) data-type=text data="{\"err_no\":0,\"err_tips\":\"success\",\"data\":{\"is_ad_preload\":false,\"ad_info\":null,\"ad_list\":[],\"ads\":[],\"has_ad\":false,\"ad_reward_amount\":0,\"ad_countdown\":0,\"count_down\":0,\"count_down_time\":0,\"incentive_ad_info\":null,\"read_gain_ad_info\":null,\"post_done_extra\":\"\"}}" status-code=200 header="Content-Type:application/json"

[Script]
# 复现抓包软件下“网络异常且不播放广告”的行为；脚本只切 Pangle 广告 API/素材链。
番茄广告上游本机断网 = type=http-request, pattern=^https?:\/\/(?:api(?:-(?:hl|lq)|[35]-normal(?:-[a-z]{2})?|5-normal-sinfonline[ab])?\.fqnovel\.com\/luckycat\/novel\/v1\/task\/(?:get_ad_info|excitation_ad_right\/detail)\/?|(?:i|i-(?:hl|lq))\.snssdk\.com\/video\/play\/[^?#]+\?(?:[^#]*&)?ad_id=\d+|api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/(?:settings|stats\/batch|get_ads|material\/check|app_log)\/?|(?:sf3|sf6)-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/|lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/|(?:ad|ads|ads3-normal(?:-[a-z]{2})?|ads5-normal(?:-[a-z]{2})?)\.zijieapi\.com\/|pangolin(?:16)?\.snssdk\.com\/), script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/fqxs-network-cut.js?v=20260727-4, script-update-interval=86400, timeout=2, engine=jsc
# 清理番茄 settings/AB、正文广告节点与底部活动横幅。
番茄阅读广告与底部活动响应清理 = type=http-response, pattern=^https?:\/\/(?:(?:is|i|ib)\.snssdk\.com\/service\/settings\/v[23]\/?|reading(?:-(?:hl|lq))?\.snssdk\.com\/reading\/reader\/batch_full\/v[^\/?#]+\/?|api(?:-(?:hl|lq)|[35]-normal(?:-[a-z]{2})?|5-normal-sinfonline[ab])?\.fqnovel\.com\/), script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/fqxs-reader-ad-clean.js?v=20260727-4, requires-body=true, max-size=5242880, timeout=5, engine=jsc
番茄区域 settings 广告响应清理 = type=http-response, pattern=^https?:\/\/i-(?:hl|lq)\.snssdk\.com\/service\/settings\/v[23]\/?, script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/fqxs-reader-ad-clean.js?v=20260727-4, requires-body=true, max-size=5242880, timeout=5, engine=jsc

