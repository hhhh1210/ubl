#!name=番茄小说 7.2.9 正文插播去广告
#!desc=针对阅读器正文/章节插播、底部活动横幅、开屏、小游戏和激励广告。基于 7.2.9 IPA 的 GameAdData、commerce/tab、reader/chapter/splash 与 Gecko 组件证据制作，不依赖 HAR 捕获广告接口。
#!author=Cowork local analysis
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1468454200
#!tag=番茄小说,正文广告,底部横幅,开屏,小游戏,激励广告
#!date=2026-07-27
#!version=20260727-4

# IPA: 番茄小说 7.2.9 / 7.2.9.32, Bundle ID com.dragon.read, aid 1967。
# 结构证据: EcomData.ad_json/game_ad, GameAdData.xs_ad_pos/xs_chapter_pos,
# chapter_middle_ad_config, reading_ad_lynx, novel_ad_config,
# reader_front_ad_slide_config_v286，以及 //nonStandardAd、//ad_lynx_aggregation 路由。
# HAR 无法捕获广告包，因此本模块强制相关主机进入 Surge HTTP 引擎，并同时处理
# 番茄 JSON 中的阅读器广告/底部运营位、开屏 SDK、小游戏承载页和广告素材。
# 2026-07-27 抓包显示点击“看视频免30分钟广告”后会访问三个 ecombdapi 区域节点；
# 其他抓包软件令这些连接失败时，App 显示网络异常且不会启动广告视频。
# 18:32 新 HAR 在两类广告出现期间仍只捕到 PCDN settings，说明 Pangle/正文广告继续绕过 HTTP 引擎。
# 本版改用请求阶段本机断网，并补齐 api-hl/api-lq、激励信息与阅读 AB 配置入口。
# 19:05 HAR 命中 i.snssdk.com/video/play，查询参数包含 ad_id，响应返回完整广告视频播放地址；
# 本版仅切断带 ad_id 的 video/play 请求，不影响无 ad_id 的普通视频。
# IPA KMP 元数据确认正文来自 /reading/reader/batch_full/v*/，并包含 AdContext、
# AdUrlData/non_std_ad_id；激励入口为 get_ad_info 与 excitation_ad_right/detail。
# 本版从这两条上游链处理，动态 fqnovelvod/byteimg 素材域不再作为主要拦截目标。

[General]
skip-proxy = %APPEND% 127.0.0.1, localhost, ::1
force-http-engine-hosts = %APPEND% i-hl.snssdk.com, i-lq.snssdk.com
force-http-engine-hosts = %APPEND% lf-sourcecdn-tos.bytegecko.com, lf-dy-sourcecdn-tos.bytegecko.com, lf-sourcecdn-tos.bytegoofy.com, tosv.byted.org, lf3-reading.fqnovelpic.com, open.e.kuaishou.com, open.e.kuaishou.cn, sdk.e.qq.com, sdkquic.e.qq.com, v2mi.gdt.qq.com, mobads.baidu.com, bgg.baidu.com, feed-image.baidu.com, sdk.1rtb.net, cdn.1rtb.com, api.qttunion.com, service.qttunion.com, cpc-service-square.aiclk.com, logrcv.aiclk.com, tracelog-debug.aiclk.com, sdk.zhangyuyidong.cn, sdk-log.partner.sm.cn, qh-material.taobao.com, atoken.m.taobao.com, usr-api.1sapp.com
force-http-engine-hosts = %APPEND% is.snssdk.com, i.snssdk.com, ib.snssdk.com, api.fqnovel.com, api-hl.fqnovel.com, api-lq.fqnovel.com, api3-normal.fqnovel.com, api5-normal.fqnovel.com, api3-normal-lf.fqnovel.com, api3-normal-hl.fqnovel.com, api3-normal-lq.fqnovel.com, api5-normal-lf.fqnovel.com, api5-normal-hl.fqnovel.com, api5-normal-lq.fqnovel.com, api5-normal-sinfonlinea.fqnovel.com, api5-normal-sinfonlineb.fqnovel.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao-b.com, ad.zijieapi.com, ads.zijieapi.com, ads3-normal.zijieapi.com, ads3-normal-lf.zijieapi.com, ads3-normal-hl.zijieapi.com, ads3-normal-lq.zijieapi.com, ads5-normal.zijieapi.com, ads5-normal-lf.zijieapi.com, ads5-normal-hl.zijieapi.com, ads5-normal-lq.zijieapi.com, minigame.zijieapi.com, minigame3-normal.zijieapi.com, minigame3-normal-lf.zijieapi.com, minigame3-normal-hl.zijieapi.com, minigame3-normal-lq.zijieapi.com, minigame5-normal.zijieapi.com, minigame5-normal-lf.zijieapi.com, minigame5-normal-hl.zijieapi.com, minigame5-normal-lq.zijieapi.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, lf-cdn-tos.bytescm.com, reading.snssdk.com, reading-hl.snssdk.com, reading-lq.snssdk.com, gecko.zijieapi.com, gecko3.zijieapi.com, gecko5.zijieapi.com, lf-fe.fqnovelstatic.com

[Rule]
# 广告/小游戏承载域直接拒绝；番茄业务域只做响应清理，不整域拦截。
# Pangle 主请求由 [Script] 改写到本机拒绝端口；localhost 必须直连，不能再进入代理链。
DOMAIN,localhost,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve
# 94_1785124660022.zip 显示广告相关主机通过 DNSPod DoH 解析；禁用该绕过并回退系统 DNS。
IP-CIDR,120.53.53.53/32,REJECT,no-resolve
DOMAIN,ad.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads.zijieapi.com,REJECT,extended-matching,pre-matching
# tnc.json 会在应用内部把 ad/ads 重写到这些节点；域名层拒绝不依赖 MITM。
DOMAIN,ads3-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads3-normal-lf.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT,extended-matching,pre-matching
