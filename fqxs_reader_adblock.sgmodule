#!name=番茄小说 7.2.9 正文插播去广告
#!desc=针对阅读器正文/章节插播、底部活动横幅、开屏、小游戏和激励广告。基于 7.2.9 IPA 的 GameAdData、reader/chapter/splash 与 Gecko 组件证据制作，不依赖 HAR 捕获广告接口。
#!author=Cowork local analysis
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1468454200
#!tag=番茄小说,正文广告,底部横幅,开屏,小游戏,激励广告
#!date=2026-07-26

# IPA: 番茄小说 7.2.9 / 7.2.9.32, Bundle ID com.dragon.read, aid 1967。
# 结构证据: EcomData.ad_json/game_ad, GameAdData.xs_ad_pos/xs_chapter_pos,
# enable_insert_ad, insert_ad_rit_type, reader_front_ad_slide_config_v286。
# HAR 无法捕获广告包，因此本模块强制相关主机进入 Surge HTTP 引擎，并同时处理
# 番茄 JSON 中的阅读器广告/底部运营位、开屏 SDK、小游戏承载页和广告素材。

[General]
force-http-engine-hosts = %APPEND% lf-sourcecdn-tos.bytegecko.com, lf-dy-sourcecdn-tos.bytegecko.com, lf-sourcecdn-tos.bytegoofy.com, tosv.byted.org, lf3-reading.fqnovelpic.com, open.e.kuaishou.com, open.e.kuaishou.cn, sdk.e.qq.com, sdkquic.e.qq.com, v2mi.gdt.qq.com, mobads.baidu.com, bgg.baidu.com, feed-image.baidu.com, sdk.1rtb.net, cdn.1rtb.com, api.qttunion.com, service.qttunion.com, cpc-service-square.aiclk.com, logrcv.aiclk.com, tracelog-debug.aiclk.com, sdk.zhangyuyidong.cn, sdk-log.partner.sm.cn, qh-material.taobao.com, atoken.m.taobao.com, usr-api.1sapp.com
force-http-engine-hosts = %APPEND% is.snssdk.com, i.snssdk.com, ib.snssdk.com, api.fqnovel.com, api3-normal.fqnovel.com, api5-normal.fqnovel.com, api3-normal-lf.fqnovel.com, api3-normal-hl.fqnovel.com, api3-normal-lq.fqnovel.com, api5-normal-lf.fqnovel.com, api5-normal-hl.fqnovel.com, api5-normal-lq.fqnovel.com, api5-normal-sinfonlinea.fqnovel.com, api5-normal-sinfonlineb.fqnovel.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao-b.com, ad.zijieapi.com, ads.zijieapi.com, ads3-normal.zijieapi.com, ads3-normal-lf.zijieapi.com, ads3-normal-hl.zijieapi.com, ads3-normal-lq.zijieapi.com, ads5-normal.zijieapi.com, ads5-normal-lf.zijieapi.com, ads5-normal-hl.zijieapi.com, ads5-normal-lq.zijieapi.com, minigame.zijieapi.com, minigame3-normal.zijieapi.com, minigame3-normal-lf.zijieapi.com, minigame3-normal-hl.zijieapi.com, minigame3-normal-lq.zijieapi.com, minigame5-normal.zijieapi.com, minigame5-normal-lf.zijieapi.com, minigame5-normal-hl.zijieapi.com, minigame5-normal-lq.zijieapi.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, lf-cdn-tos.bytescm.com, reading.snssdk.com, lf-fe.fqnovelstatic.com

[Rule]
# 广告/小游戏承载域直接拒绝；番茄业务域只做响应清理，不整域拦截。
DOMAIN,ad.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads.zijieapi.com,REJECT,extended-matching,pre-matching
# tnc.json 会在应用内部把 ad/ads 重写到这些节点；域名层拒绝不依赖 MITM。
DOMAIN,ads3-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads3-normal-lf.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads3-normal-lq.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads5-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads5-normal-lf.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,ads5-normal-lq.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,bytescm.com,REJECT,extended-matching,pre-matching
DOMAIN,pangolin.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,pangolin16.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,open.e.kuaishou.com,REJECT,extended-matching,pre-matching
DOMAIN,open.e.kuaishou.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ksapisrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.e.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,sdkquic.e.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,v2mi.gdt.qq.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdtimg.com,REJECT,extended-matching,pre-matching
DOMAIN,mobads.baidu.com,REJECT,extended-matching,pre-matching
DOMAIN,bgg.baidu.com,REJECT,extended-matching,pre-matching
DOMAIN,feed-image.baidu.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.1rtb.net,REJECT,extended-matching,pre-matching
DOMAIN,cdn.1rtb.com,REJECT,extended-matching,pre-matching
DOMAIN,api.qttunion.com,REJECT,extended-matching,pre-matching
DOMAIN,service.qttunion.com,REJECT,extended-matching,pre-matching
DOMAIN,cpc-service-square.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,logrcv.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,tracelog-debug.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.zhangyuyidong.cn,REJECT,extended-matching,pre-matching
DOMAIN,sdk-log.partner.sm.cn,REJECT,extended-matching,pre-matching
DOMAIN,qh-material.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN,atoken.m.taobao.com,REJECT,extended-matching,pre-matching
DOMAIN,usr-api.1sapp.com,REJECT,extended-matching,pre-matching
DOMAIN,minigame.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,minigame3-normal.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,minigame3-normal-lf.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,minigame3-normal-hl.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,minigame3-normal-lq.zijieapi.com,REJECT,extended-matching,pre-matching
