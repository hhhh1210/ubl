#!name=APTV Live Fast Reconnect
#!desc=Observe APTV 163189.xyz HTTP live streams, then kill stale active stream requests before the player waits around 25s.
#!system=mac

[General]
force-http-engine-hosts = %APPEND% *.163189.xyz

[Script]
APTV stream activity marker = type=http-request, pattern=^http:\/\/[^\/]+\.163189\.xyz(?::80)?\/(?:stream\/|api\/|163189\/), script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/aptv-kill-stale.js, script-update-interval=86400, argument=mode=mark&activeWindow=30, timeout=2
APTV stale stream killer = type=cron, cronexp="*/5 * * * * *", script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/aptv-kill-stale.js, script-update-interval=86400, argument=mode=cron&domain=163189.xyz&pathPrefixes=/stream/%2C/api/%2C/163189/&stale=5&maxAge=18&activeWindow=30, timeout=4
