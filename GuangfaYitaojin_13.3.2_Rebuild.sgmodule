#!name=广发易淘金 13.3.2 去广告重配 20260923
#!desc=单文件 JQ 响应清理，需要 Surge iOS 5.14+、重写和 MitM。首次使用停用旧广发去广告规则/脚本。本地样本验证通过，尚待 iPhone 实测；保留登录、交易、行情、宫格和系统公告。
#!category=去广告
#!author=Local IPA analysis

# 基于指定 IPA 的 gateway_release.json、React Native 模块及公开无登录响应。
# 不需要下载远程脚本；不修改 IPA；不要与旧广发清理脚本同时启用。
# 原生界面固定占位或磁盘内已有广告，可能仍需 App 自带清缓存及刷新。
# popup/v2 与 fund_ad 缺少成功响应样本；只处理 retcode=0 且含 data 的响应。

[Body Rewrite]
# 开屏：使用服务器真实无广告结构，保留 retcode/msg
http-response-jq ^https?://config\.gf\.com\.cn(?::443)?/ad/info/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (if (.data | type) == "object" or .data == null then .data = {"begin_date":0,"end_date":0,"img":"","href":"","md5":"","target":"","non_trade_time":0,"name":"","title":"","type":"","source":"","sub_source":"","data_id":"","strategy_id":""} else . end) else . end else . end'

# 开户/信用页广告、逆回购 Banner、交易页营销卡片
http-response-jq ^https?://config\.gf\.com\.cn(?::443)?/(?:ad/list|front/get_ads|trade/card)/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then [] elif type == "object" then {} else . end)) else . end else . end'

# 首页/理财 Banner：保留全部宫格和栏目
http-response-jq ^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/homepage_elements/v2/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "object" then with_entries(if (.key == "banner2020" or .key == "lcb_banner") and (.value | type) == "array" then .value = [] else . end) else . end)) else . end else . end'

# 发现页：去除 Banner/VIP/荐股营销卡，保留快讯、自选资讯及工具
http-response-jq ^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/find_marketing/list/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then map(select(if type == "object" then (.category as $category | ["banner", "vipinfo", "vipranking", "vipranking_col", "vip_or_gold", "vipinfo_pkg", "recommend", "golden_and_rui", "golden_stock"] | index($category) | not) else true end)) else . end)) else . end else . end'

# CMS 活动弹窗/转账挽留弹窗：只改成功且有 data 的响应
http-response-jq ^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/(?:popup/(?:v2|yzzz)|cash/yzzz(?:_in)?)/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then [] elif type == "object" then {} else . end)) else . end else . end'

# 持仓运营 Banner
http-response-jq ^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/(?:activity/holder_marketing|ecss/activity/holder_marketing/list)/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then [] elif type == "object" then {} else . end)) else . end else . end'

# 我的页面：清除开户推广图和跳转，保留对象结构
http-response-jq ^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/my_page/open_account_marketing/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "object" then with_entries(if (.key == "my_new_open" or .key == "my_open_interrupt") and (.value | type) == "object" then .value |= (.image = "" | .black_image = "" | .jump_url = "" | .title = "") else . end) else . end)) else . end else . end'

# 混合配置：仅删除已核实的年度功能推广及 trade_new_open 营销项
http-response-jq ^https?://config\.gf\.com\.cn(?::443)?/ytj_config/info/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then map(select(if type != "object" then true elif .id == "trade_new_open" then false elif .id == "diagnostic_report" and (.data | type) == "array" then (any(.data[]; if type == "object" then .Key == "link" and (if (.Value | type) == "string" then (.Value | contains("hd.gf.com.cn/gfmobile/version/")) else false end) else false end) | not) else true end)) else . end)) else . end else . end'

# 场内基金广告文字链：限定 fund_ad，不匹配其他行情请求
http-response-jq ^https?://qd\.gf\.com\.cn(?::443)?/api/v1/quote/fund_ad/?(?:\?.*)?$ 'if type == "object" then if .retcode == 0 and has("data") then (.data |= (if type == "array" then [] elif type == "object" then {} else . end)) else . end else . end'

[Header Rewrite]
# 仅作用于上面九组路径；标记表示命中路径，不保证正文一定被修改。
http-request (?:^https?://config\.gf\.com\.cn(?::443)?/ad/info/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/(?:ad/list|front/get_ads|trade/card)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/homepage_elements/v2/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/find_marketing/list/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/(?:popup/(?:v2|yzzz)|cash/yzzz(?:_in)?)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/(?:activity/holder_marketing|ecss/activity/holder_marketing/list)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/my_page/open_account_marketing/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/ytj_config/info/?(?:\?.*)?$|^https?://qd\.gf\.com\.cn(?::443)?/api/v1/quote/fund_ad/?(?:\?.*)?$) header-del If-None-Match
http-request (?:^https?://config\.gf\.com\.cn(?::443)?/ad/info/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/(?:ad/list|front/get_ads|trade/card)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/homepage_elements/v2/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/find_marketing/list/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/(?:popup/(?:v2|yzzz)|cash/yzzz(?:_in)?)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/(?:activity/holder_marketing|ecss/activity/holder_marketing/list)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/my_page/open_account_marketing/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/ytj_config/info/?(?:\?.*)?$|^https?://qd\.gf\.com\.cn(?::443)?/api/v1/quote/fund_ad/?(?:\?.*)?$) header-del If-Modified-Since
