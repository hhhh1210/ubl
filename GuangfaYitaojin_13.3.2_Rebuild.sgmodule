http-request (?:^https?://config\.gf\.com\.cn(?::443)?/ad/info/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/(?:ad/list|front/get_ads|trade/card)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/homepage_elements/v2/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/find_marketing/list/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/(?:popup/(?:v2|yzzz)|cash/yzzz(?:_in)?)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/(?:activity/holder_marketing|ecss/activity/holder_marketing/list)/?(?:\?.*)?$|^https?://midend\.gf\.com\.cn(?::443)?/gfmiddle/activity/my_page/open_account_marketing/?(?:\?.*)?$|^https?://config\.gf\.com\.cn(?::443)?/ytj_config/info/?(?:\?.*)?$|^https?://qd\.gf\.com\.cn(?::443)?/api/v1/quote/fund_ad/?(?:\?.*)?$) header-add Cache-Control no-cache
