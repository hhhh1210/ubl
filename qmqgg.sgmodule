#!name=七猫小说去广告_修复开屏
#!desc=基于 QingRex 原模块 + 2026-06-14 四份 HAR/IPA 静态分析补充。重点修复 8.0 版开屏广告：a6-remad、Ubix/66mobi、Pangle/Volc 与 Kuaishou/KSAd 回退链路。
#!author=QingRex 原规则 + Cowork 3P 本地分析
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1387717110
#!tag=去广告,开屏广告
#!date=2026-06-14

# 分析依据：
# 1. 参考模块已处理旧版 api-cfg.wtzw.com/v*/splash，但 HAR 显示 8.0 版开屏广告实际命中 a6-remad.qm989.com/v3/get-splash/index 与 /v3/get-contract/index。
# 2. 03:40 HAR：a6-remad 两个请求均为 POST，ad_unit_id=10295、scene=10、ad_format=2、start_mode=1、flow_id=4468，响应 ads_list 含京东开屏广告素材。
# 3. 04:02 HAR：开屏广告改走 Ubix/66mobi 聚合链路，entry-su1.ubixioe.com/mob/sdk/v2/endpoint 响应中含京东素材、66mobi 追踪、adsource_show=true、interaction_type=3。
# 4. 04:12 HAR：残留启动链路集中在 drs/cgcr/abtest 远程配置与 Douyin/Pangle/Volc 初始化接口，其中 pangle setting 返回 init_enable=true 与广告位配置。
# 5. 04:21 HAR：开屏回退到 Kuaishou/KSAd，open.e.kuaishou.com/rest/e/v3/open/univ 连续请求，其中一条响应 hasAd=true 且 impAdInfo 体积约 13KB。
# 6. 04:27 HAR：Kuaishou 链路改走 open.e.kuaishou.cn，并出现 /rest/e/v3/open/logBatch；需同时覆盖 .com 与 .cn。
# 7. IPA 静态字符串确认存在 QXMAdSDK、QXMQuMengAdapter、QuMengAdSDK、QuMengSplashAd、QXMSplash、QMSplash、SplashCacheKeyPath、KSSplashAdView。

[Rule]
# 原模块规则
DOMAIN,cdn-ad.wtzw.com,REJECT,extended-matching,pre-matching
DOMAIN,cdn-new-ad.wtzw.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdt.qq.com,REJECT,extended-matching,pre-matching

# 8.0 HAR 中出现的开屏/聚合广告 SDK 与素材域名
DOMAIN,a6-remad.qm989.com,REJECT,extended-matching,pre-matching
# ad-drs.52qumao.com / ad-drs-ipv6.52qumao.com 是短剧页面/播放期状态链路，不做 Rule 层整域拦截。
# pangolin 主域不做 Rule 层整域拦截：短剧页面/播放期会调用 settings、stats/batch、app_log 等状态回调；仅在 URL Rewrite 中拦截 get_ads/material/check。
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,bytescm.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gdtimg.com,REJECT,extended-matching,pre-matching
DOMAIN,sdkquic.e.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.e.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,v2mi.gdt.qq.com,REJECT,extended-matching,pre-matching
# mobads.baidu.com/cpro/ui/mads.php 是 WebView/HTML 广告位，短剧界面会出现 XML/错误页显示；不做 Rule 层整域拒绝，改由 Map Local 返回空白 HTML。
# mobads-logs.baidu.com/dz.zb 是短剧页面/播放期日志链路，放行。
DOMAIN,bgg.baidu.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.1rtb.net,REJECT,extended-matching,pre-matching
DOMAIN,cpc-service-square.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,logrcv.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,tracelog-debug.aiclk.com,REJECT,extended-matching,pre-matching
DOMAIN,api.qttunion.com,REJECT,extended-matching,pre-matching
DOMAIN,service.qttunion.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk.zhangyuyidong.cn,REJECT,extended-matching,pre-matching
DOMAIN,cfgc.zztfly.com,REJECT,extended-matching,pre-matching
DOMAIN,cdn-api-auth.zztfly.com,REJECT,extended-matching,pre-matching
DOMAIN,api-auth.zztfly.com,REJECT,extended-matching,pre-matching

# 04:02 HAR 追加：Ubix/66mobi/神马/UC/52qumao 聚合开屏链路
DOMAIN,entry-su1.ubixioe.com,REJECT,extended-matching,pre-matching
DOMAIN,md-cfg-u1.ubixioe.com,REJECT,extended-matching,pre-matching
DOMAIN,adx-cfg-u1.ubixioe.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ubixioe.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,66mobi.com,REJECT,extended-matching,pre-matching
DOMAIN,partner.uc.cn,REJECT,extended-matching,pre-matching
DOMAIN,hc-ssp.sm.cn,REJECT,extended-matching,pre-matching
DOMAIN,api-adx.52qumao.com,REJECT,extended-matching,pre-matching
DOMAIN,api-cfg.52qumao.com,REJECT,extended-matching,pre-matching
# ad-drs-ipv6.52qumao.com 与 52qumao 状态链路放行；只拦截 api-adx/api-cfg 广告请求。
# 京东 App 图片使用 360buyimg/JD CDN；不做全局拦截，避免影响京东图片显示。
DOMAIN,atoken.m.taobao.com,REJECT,extended-matching,pre-matching

# 04:12 HAR 追加：残留开屏进入远程配置/抖音 Pangle/火山链路
DOMAIN,webcast-open.douyin.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,douyin.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,douyinstatic.com,REJECT,extended-matching,pre-matching
DOMAIN,klink.volceapplog.com,REJECT,extended-matching,pre-matching
DOMAIN,log-klink.zijieapi.com,REJECT,extended-matching,pre-matching
# mon/drs/cgcr/abtest/mssdk/vod-license 等短剧页面与播放状态链路放行；仅保留明确广告初始化域名。
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT,extended-matching,pre-matching
DOMAIN,sdk-log.partner.sm.cn,REJECT,extended-matching,pre-matching

# 04:21 HAR 追加：Kuaishou/KSAd 回退开屏链路与广告日志
DOMAIN,open.e.kuaishou.com,REJECT,extended-matching,pre-matching
DOMAIN,open.e.kuaishou.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,kuaishou.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,kuaishou.cn,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ksapisrv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,gifshow.com,REJECT,extended-matching,pre-matching
# toblog.ctobsnssdk.com 日志/注册链路放行，避免影响短剧页面状态。
DOMAIN,sdklog.zhangyuyidong.cn,REJECT,extended-matching,pre-matching
DOMAIN,usr-api.1sapp.com,REJECT,extended-matching,pre-matching

# 20:33 HAR：短剧界面触发“网络异常/代理风险”弹窗时大量访问 checkip.amazonaws.com，并出现 119.29.29.98 HTTPDNS 探测。IPA 主程序静态字符串含 isShowProxyAlert/kProxyConfig/CFNetworkCopySystemProxySettings，说明这是代理风险检测链路；这些探测必须直连，不能走代理或 MITM。
DOMAIN,checkip.amazonaws.com,DIRECT
IP-CIDR,119.29.29.98/32,DIRECT,no-resolve

[URL Rewrite]
# 原模块规则
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject
^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\/ - reject
^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\/ - reject

# 8.0 开屏关键路径。Map Local 在下方返回空广告列表；这里作为不支持 Map Local 时的兜底拒绝。
^https:\/\/a6-remad\.qm989\.com\/v3\/(get-splash|get-contract)\/index - reject

# HAR 中的聚合广告 SDK 请求兜底。20:13 HAR 证明 get_ads 硬拒绝会卡住短剧预广告/播放门控，因此只硬拒绝 material/check。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/material\/check\/ - reject
# Pangle get_ads 不再 URL Rewrite 硬拒绝，改在 Map Local 返回无广告 JSON；settings / stats / app_log 放行。
^https?:\/\/sdk\.1rtb\.net\/sdk\/(config|req_ad) - reject
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg - reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch - reject
^https?:\/\/sdk\.e\.qq\.com\/ola\/v2 - reject
# mobads.baidu.com/cpro/ui/mads.php 不再硬拒绝，改在 Map Local 返回空白 HTML，避免短剧界面 WebView 露出 XML/错误页。
# mobads-logs.baidu.com 放行：短剧页面/播放期日志链路。
^https?:\/\/bgg\.baidu\.com\/bgg\/produce - reject
^https?:\/\/cpc-service-square\.aiclk\.com\/v1\/getConfig - reject
^https?:\/\/tracelog-debug\.aiclk\.com\/ - reject
^https?:\/\/logrcv\.aiclk\.com\/ - reject
^https?:\/\/api\.qttunion\.com\/v5\/json - reject
^https?:\/\/service\.qttunion\.com\/qmcd\/get - reject
^https?:\/\/sdk\.zhangyuyidong\.cn\/sdk\/config - reject
^https?:\/\/cfgc\.zztfly\.com\/v5\/gcf - reject
^https?:\/\/cdn-api-auth\.zztfly\.com\/api\/initSecCdn\/ - reject
^https?:\/\/api-auth\.zztfly\.com\/api\/initSec - reject

# 04:02 HAR：实际残留开屏素材来自 Ubix/66mobi 聚合返回，响应为 base64/protobuf-like，包含 JD 素材与 66mobi 追踪。
^https?:\/\/entry-su1\.ubixioe\.com\/mob\/sdk\/v2\/endpoint - reject
^https?:\/\/md-cfg-u1\.ubixioe\.com\/mob\/mediation\/v3\/conf - reject
^https?:\/\/adx-cfg-u1\.ubixioe\.com\/mob\/sdk\/v3\/init - reject
^https?:\/\/e-u1\.ubixioe\.com\/ - reject
^https?:\/\/partner\.uc\.cn\/mediations - reject
^https?:\/\/hc-ssp\.sm\.cn\/ - reject
^https?:\/\/api-adx\.52qumao\.com\/v2\/get-bz-ads\/index - reject
^https?:\/\/api-cfg\.52qumao\.com\/v1\/init - reject
# ad-drs-ipv6.52qumao.com/v1/config/attribute/log 放行，短剧页面/播放期依赖 52qumao 状态链路。
^https?:\/\/tencent-ssp\.66mobi\.com\/ - reject
^https?:\/\/static\.66mobi\.com\/ - reject
# 360buyimg/JD CDN 放行；避免误伤京东 App 图片与资源。
^https?:\/\/atoken\.m\.taobao\.com\/ - reject

# 04:12 HAR：进一步阻断开屏相关远程配置和 Pangle/Volc 初始化链路。
# drs/cgcr/abtest 是短剧页面接口，放行避免页面只显示缓存、点击网络失败。
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/setting\/ - reject
^https?:\/\/[^\/]+\.douyinstatic\.com\/webcast-open-setting\/ - reject
^https?:\/\/klink\.volceapplog\.com\/service\/2\/device_register\/ - reject
^https?:\/\/log-klink\.zijieapi\.com\/service\/2\/device_register\/ - reject
# mon/mssdk/vod-license 状态链路放行；tnc 域名解析保留拦截。
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ - reject
^https?:\/\/sdk-log\.partner\.sm\.cn\/sdk_log - reject

# 04:21 HAR：Kuaishou/KSAd 回退开屏链路；open/univ 返回 hasAd=true 时携带加密 impAdInfo，可直接阻断或用 Map Local 置空。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/univ - reject
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/logBatch - reject
# toblog.ctobsnssdk.com 日志/注册链路放行，避免影响短剧页面状态。
^https?:\/\/sdklog\.zhangyuyidong\.cn\/sdk\/logReport - reject
^https?:\/\/usr-api\.1sapp\.com\/report\/v1 - reject

[Body Rewrite]
# 原模块规则：个人中心功能区广告位
http-response-jq ^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\? 'delpaths([["data","func_area",1]])'
http-response-jq ^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\? 'delpaths([["data","func_area",2]])'

[Map Local]
# 8.0 开屏广告真正命中点：返回空广告列表，避免客户端继续渲染 ads_list 中的开屏素材。
^https:\/\/a6-remad\.qm989\.com\/v3\/get-splash\/index data-type=text data="{\"data\":{\"ads_list\":[]}}" status-code=200 header="Content-Type:application/json"
^https:\/\/a6-remad\.qm989\.com\/v3\/get-contract\/index data-type=text data="{\"data\":{\"ads_list\":[]}}" status-code=200 header="Content-Type:application/json"

# 原模块 Map Local
^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# JSON 广告 SDK 的空响应兜底
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg data-type=text data="{\"ret\":0,\"msg\":\"\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mobads\.baidu\.com\/cpro\/ui\/mads\.php data-type=text data="<html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body></body></html>" status-code=200 header="Content-Type:text/html; charset=utf-8"
# Pangle stats/batch 放行，不再 Map Local，避免影响短剧页面状态回调；get_ads 返回无广告 JSON，避免硬拒绝导致短剧预广告/播放门控中断。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ data-type=text data="{\"request_id\":\"surge-no-ad\",\"status_code\":20001,\"reason\":141,\"desc\":\"no ad\"}" status-code=200 header="Content-Type:application/json"

# Ubix/66mobi 聚合链路空响应：用于避免 04:02 HAR 中 entry-su1 返回可渲染开屏素材。
^https?:\/\/entry-su1\.ubixioe\.com\/mob\/sdk\/v2\/endpoint data-type=text data="" status-code=204 header="Content-Type:application/octet-stream"
^https?:\/\/md-cfg-u1\.ubixioe\.com\/mob\/mediation\/v3\/conf data-type=text data="" status-code=204 header="Content-Type:application/octet-stream"
^https?:\/\/adx-cfg-u1\.ubixioe\.com\/mob\/sdk\/v3\/init data-type=text data="" status-code=204 header="Content-Type:application/octet-stream"
^https?:\/\/partner\.uc\.cn\/mediations data-type=text data="{\"code\":0,\"msg\":\"OK\",\"data\":{\"api_ver\":\"2.0\",\"ad_units\":[],\"placements\":[],\"extended_resources\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api-adx\.52qumao\.com\/v2\/get-bz-ads\/index data-type=text data="{\"errors\":{\"code\":\"44010102\",\"status\":\"200\",\"title\":\"无竞胜方\",\"details\":\"无竞胜方\"}}" status-code=200 header="Content-Type:application/json"
# ad-drs-ipv6.52qumao.com/v1/config/attribute/log 不再 Map Local，避免影响短剧页面接口。
^https?:\/\/hc-ssp\.sm\.cn\/ data-type=text data="{\"code\":\"137\",\"reason\":\"Filtered\",\"server_time\":\"0\",\"slot_ad\":[]}" status-code=200 header="Content-Type:application/json"

# 04:12 HAR 远程配置空响应。注意：这些配置较激进，只用于定位/清理开屏残留；如影响正常功能，可优先放开 drs/cgcr/abtest 三条。
# drs/cgcr/abtest 不再 Map Local，避免短剧页面接口被置空。
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/setting\/ data-type=text data="{\"data\":{\"init_enable\":false,\"extra_settings\":{\"init_enable\":false,\"use_pangle_plugin\":false,\"enable_feed_no_ad\":true,\"ad_id\":{}}},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
# mon.zijieapi.com/cloudcontrol 放行，不再 Map Local。
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ data-type=text data="{\"data\":{},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"

# 04:21 HAR Kuaishou/KSAd 空响应：该 HAR 中 open.e.kuaishou.com/rest/e/v3/open/univ 连续请求，命中一条 hasAd=true 的开屏候选。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/univ data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"impAdInfo\":\"\",\"extra\":\"\",\"adGlobalConfigInfo\":\"\",\"hasAd\":false}" status-code=200 header="Content-Type:application/json"
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/logBatch data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"interval\":3600}" status-code=200 header="Content-Type:application/json"
# toblog.ctobsnssdk.com 日志/注册链路不再 Map Local。
^https?:\/\/sdklog\.zhangyuyidong\.cn\/sdk\/logReport data-type=text data="" status-code=204
^https?:\/\/usr-api\.1sapp\.com\/report\/v1 data-type=text data="{\"code\":\"000\",\"msg\":\"ok\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api-cfg.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, api-bc.wtzw.com, api-gw.wtzw.com, cdn.wtzw.com, a6-remad.qm989.com, ad-drs.52qumao.com, ad-drs-ipv6.52qumao.com, api-adx.52qumao.com, api-cfg.52qumao.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao-b.com, lf-cdn-tos.bytescm.com, v2mi.gdt.qq.com, sdkquic.e.qq.com, sdk.e.qq.com, qzs.gdtimg.com, mobads.baidu.com, mobads-logs.baidu.com, bgg.baidu.com, sdk.1rtb.net, cpc-service-square.aiclk.com, logrcv.aiclk.com, tracelog-debug.aiclk.com, api.qttunion.com, service.qttunion.com, sdk.zhangyuyidong.cn, cfgc.zztfly.com, cdn-api-auth.zztfly.com, api-auth.zztfly.com, entry-su1.ubixioe.com, md-cfg-u1.ubixioe.com, adx-cfg-u1.ubixioe.com, e-u1.ubixioe.com, partner.uc.cn, hc-ssp.sm.cn, tencent-ssp.66mobi.com, static.66mobi.com, atoken.m.taobao.com, webcast-open.douyin.com, *.douyinstatic.com, klink.volceapplog.com, log-klink.zijieapi.com, mon.zijieapi.com, tnc3-alisc1.zijieapi.com, mssdk.volces.com, vod-license-m.volccdn.com, sdk-log.partner.sm.cn, abtest.wtzw.com, cgcr.wtzw.com, drs-ipv6.wtzw.com, drs.wtzw.com, open.e.kuaishou.com, open.e.kuaishou.cn, *.kuaishou.com, *.kuaishou.cn, toblog.ctobsnssdk.com, sdklog.zhangyuyidong.cn, usr-api.1sapp.com, xiaoshuo.wtzw.com
