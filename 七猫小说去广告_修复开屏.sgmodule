^https?:\/\/toblog\.ctobsnssdk\.com\/service\/2\/log_settings\/ data-type=text data="{\"server_time\":0,\"magic_tag\":\"ss_app_log\",\"config\":{\"bav_log_collect\":false,\"bav_ab_config\":false,\"bav_monitor_rate\":0,\"batch_event_interval\":3600,\"real_time_events\":[],\"send_launch_timely\":0,\"session_interval\":3600}}" status-code=200 header="Content-Type:application/json"
