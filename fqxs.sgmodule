#!name=fqxs
#!desc=番茄小说 7.2.7 去广告模块。基于本地 IPA/HAR 静态证据 + 七猫小说同类广告链路参考，保守处理开屏、激励广告、信息流/评论广告与常见 SDK 回退链。
#!author=Cowork local analysis
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id1468454200
#!tag=番茄小说,去广告,开屏广告,激励广告
#!date=2026-07-06

# 分析依据：
# 1. IPA: /Users/aa/Downloads/i4ToolsDownloads/App/番茄小说_7.2.7（正版）.ipa
#    Info.plist 显示 CFBundleIdentifier=com.dragon.read，版本 7.2.7 / 7.2.7.32，AppName=novelapp，aid=1967。
# 2. IPA 主二进制 Reading 仍为 App Store 加密状态：LC_ENCRYPTION_INFO_64 cryptid=1，
#    因此主程序字符串不完整；规则只使用未加密资源包、HAR 当前命中点和同类 SDK 入口推断。
# 3. IPA 资源包确认存在 BDARewardedVideo.bundle、BDARewardedVideo_applet.bundle、
#    splashResourceCore.bundle、BDADNovelShortVideoAd.bundle、BDADNovelShortVideoCommentAd.bundle、
#    BDADLiveSaaSResource.bundle、BDADetailSDKResource.bundle、FQMonetizationSaaS.bundle。
# 4. drlynx_monetize.zst 包含免广告/VIP/变现资源：bg-adsvip、advip、ad-free-bg、ad-free-diamond。
#    growth_incentive-monorepo_novel.zst 包含 ad-reward-modal 与 is_ad_preload，说明激励广告弹窗/预加载存在。
# 5. HAR: /Users/aa/Downloads/2026-07-06-061217.har 与 /Users/aa/Downloads/2026-07-06-061516.har 均只有 2 条请求；
#    当前截片只命中 is.snssdk.com/service/settings/v2/?caller_name=pcdn_client_novelapp&aid=1967 和 Mixpanel。
# 6. 截图 /Users/aa/Downloads/IMG_7390.PNG 确认阅读器内出现“看视频免广告”激励视频广告，
#    广告素材为天猫鱼跃官方旗舰店商品卡；这类入口通常由 luckycat 增长任务 + Pangle/GroMore SDK 承接。
# 7. tnc.json 显示番茄主接口会落到 api.fqnovel.com / api5-normal.fqnovel.com 等域名；
#    因此只处理 luckycat 广告子路径，不整域拦截 fqnovel 主业务。
# 8. HAR: /Users/aa/Downloads/2026-07-06-071648.har 只有 1 条 is.snssdk.com/service/settings/v2，
#    且 response=None，说明上一版已命中启动 PCDN；残留激励广告更可能来自 SDK 缓存、未进 HTTP 引擎的广告链路或离线 Lynx 模板。
# 9. HAR: /Users/aa/Downloads/2026-07-06-084029.har 显示 is.snssdk.com/service/settings/v2 又返回 200；
#    修正 force-http-engine-hosts 所在段落，并对 /service/settings/v2 做无 query 依赖的稳定匹配。
# 10. growth_incentive-monorepo_novel.zst 同时包含 ad-reward-modal 与 watch-ad-reward-modal，
#    并定义 GET_AD_INFO_WITH_ECPM、POST_WATCH_DONE、REPORT_AD_COMMENT。
# 11. ecom_mall_cards_noveldr.zst 包含 ad.zijieapi.com、ecombdapi.com、jinritemai.com 等电商卡资源；
#    截图中的天猫商品卡属于该类广告落地卡。
# 12. 参考本地七猫小说模块：Pangle/穿山甲、Kuaishou/KSAd、GDT、Baidu、1RTB、Aiclk、QTT、Zhangyu 等
#    在小说类 App 中常作为广告回退链；这里仅拦请求型广告接口，不整域拦截番茄主业务域。
# 13. HAR: /Users/aa/Downloads/2026-07-06-190641.har 仍只有 is.snssdk.com/service/settings/v2 且 response=None；
#    说明残留激励广告没有稳定暴露在 HAR 中，需要加强离线 Lynx 模板和 luckycat 激励接口兜底。
# 14. novel-ug-share-works-fission.zst 同时包含 /luckycat/novel_fm/v1/task/get_ad_info 与 is_ad_preload；
#    growth_incentive-monorepo_novel.zst 明确引用 growth_incentive-monorepo_novel-popup/*-ad-reward-modal/template.js。
# 15. HAR: /Users/aa/Downloads/2026-07-06-212035.har 仍只捕到 is.snssdk.com/service/settings/v2；
#    截图 /Users/aa/Downloads/IMG_7392.PNG 显示已进入“打开微信小游戏”的激励视频广告页。
# 16. IPA tnc.json 直接列出 ads.zijieapi.com、ads3-normal*.zijieapi.com、ads5-normal*.zijieapi.com；
#    这是比 minigame*.zijieapi.com 更窄的广告主机组；后续截图确认小游戏承载页后再补 minigame 精确主机。
# 17. 截图 /Users/aa/Downloads/IMG_7392.PNG 显示残留广告页为“打开微信小游戏”；IPA tnc.json
#    明确存在 minigame.zijieapi.com -> minigame5-normal.zijieapi.com 的 minigame_default 路由，
#    并列出 minigame3-normal.zijieapi.com / minigame5-normal.zijieapi.com 串行容灾。
# 18. drlynx_monetize_game.zst 包含 drlynx_monetize_game/game-*-card/template.js、
#    minigameRewardTaskParams、minigame_reward_task_params 与 jumpUrl，说明小游戏卡片/激励入口是离线 Lynx 组件。
# 19. 本版补齐 minigame*.zijieapi.com、小游戏 Lynx 模板与 fqnovelstatic/reading.snssdk.com 的
#    drlynx_monetize_game 资源拦截，以覆盖“看视频/小游戏”类残留广告页。

[General]
force-http-engine-hosts = %APPEND% is.snssdk.com, api.fqnovel.com, api3-normal.fqnovel.com, api5-normal.fqnovel.com, api3-normal-lf.fqnovel.com, api3-normal-hl.fqnovel.com, api3-normal-lq.fqnovel.com, api5-normal-lf.fqnovel.com, api5-normal-hl.fqnovel.com, api5-normal-lq.fqnovel.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao-b.com, lf-sourcecdn-tos.bytegecko.com, lf-sourcecdn-tos.bytegoofy.com, tosv.byted.org, lf-cdn-tos.bytescm.com, webcast-open.douyin.com, open.e.kuaishou.com, open.e.kuaishou.cn, ad.zijieapi.com, ads.zijieapi.com, ads3-normal.zijieapi.com, ads3-normal-lf.zijieapi.com, ads3-normal-hl.zijieapi.com, ads3-normal-lq.zijieapi.com, ads5-normal.zijieapi.com, ads5-normal-lf.zijieapi.com, ads5-normal-hl.zijieapi.com, ads5-normal-lq.zijieapi.com, minigame.zijieapi.com, minigame3-normal.zijieapi.com, minigame3-normal-lf.zijieapi.com, minigame3-normal-hl.zijieapi.com, minigame3-normal-lq.zijieapi.com, minigame5-normal.zijieapi.com, minigame5-normal-lf.zijieapi.com, minigame5-normal-hl.zijieapi.com, minigame5-normal-lq.zijieapi.com, reading.snssdk.com, lf-fe.fqnovelstatic.com, ecom.snssdk.com, growth.ecombdapi.com, isaas.ecombdapi.com, doulite-mall.ecombdapi.com, mix.jinritemai.com, ffh.jinritemai.com

[Rule]
# HAR 当前命中的启动侧 PCDN 配置不做 Rule 层整域拒绝，只在 URL Rewrite / Map Local 精确处理。
URL-REGEX,^https?:\/\/is\.snssdk\.com\/service\/settings\/v[23](?:[?#/]|$),REJECT

# 字节/Pangle/GroMore 广告 SDK 入口。api-access 主域不整域拦截，用 URL/Map Local 处理 get_ads/material/check。
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching,pre-matching
