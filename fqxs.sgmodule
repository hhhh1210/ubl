DOMAIN,api.mixpanel.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
# HAR 命中的 PCDN 启动设置。
^https?:\/\/is\.snssdk\.com\/service\/settings\/v[23]\/?(?:\?.*)?$ - reject

# Pangle/穿山甲/GroMore 广告请求。get_ads 用 Map Local 返回无广告，material/check 直接拒绝。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/material\/check\/ - reject
^https?:\/\/[^\/]+\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ - reject
^https?:\/\/[^\/]+\.douyinpic\.com\/ - reject
^https?:\/\/pangolin(?:16)?\.snssdk\.com\/ - reject
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/setting\/ - reject
^https?:\/\/klink\.volceapplog\.com\/service\/2\/device_register\/ - reject
^https?:\/\/log-klink\.zijieapi\.com\/service\/2\/device_register\/ - reject
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ - reject
^https?:\/\/toblog\.ctobsnssdk\.com\/ - reject

# Kuaishou/KSAd 开屏/激励回退。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/univ - reject
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/logBatch - reject

# GDT/Baidu/1RTB/QTT/Aiclk/Zhangyu 回退请求。
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg - reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch - reject
^https?:\/\/sdk\.e\.qq\.com\/ola\/v2 - reject
^https?:\/\/sdk\.1rtb\.net\/sdk\/(config|req_ad|notice) - reject
^https?:\/\/cdn\.1rtb\.com\/ - reject
^https?:\/\/bgg\.baidu\.com\/bgg\/produce - reject
^https?:\/\/feed-image\.baidu\.com\/ - reject
^https?:\/\/api\.qttunion\.com\/v5\/json - reject
^https?:\/\/service\.qttunion\.com\/qmcd\/get - reject
^https?:\/\/cpc-service-square\.aiclk\.com\/v1\/getConfig - reject
^https?:\/\/logrcv\.aiclk\.com\/ - reject
^https?:\/\/tracelog-debug\.aiclk\.com\/ - reject
^https?:\/\/sdk\.zhangyuyidong\.cn\/(api\/zysdk|sdk\/config) - reject
^https?:\/\/sdk-log\.partner\.sm\.cn\/sdk_log - reject
^https?:\/\/qh-material\.taobao\.com\/ - reject
^https?:\/\/atoken\.m\.taobao\.com\/ - reject
^https?:\/\/usr-api\.1sapp\.com\/report\/v1 - reject
^https?:\/\/api\.mixpanel\.com\/track\/ - reject

# 番茄/字节增长侧激励广告弹窗资源。只拦广告弹窗模板，不拦 luckycat 任务/钱包主接口。
^https?:\/\/(?:lf-sourcecdn-tos\.bytegecko\.com\/obj\/byte-gurd-source|tosv\.byted\.org\/obj\/gecko-internal)\/growth\/luckycat\/lynx\/[^\/]+\/(?:ad-reward-modal|watch-ad-reward-modal)\/template\.js - reject
^https?:\/\/(?:lf-sourcecdn-tos\.bytegecko\.com|lf-sourcecdn-tos\.bytegoofy\.com|tosv\.byted\.org)\/.*\/growth_incentive-monorepo_novel-popup\/(?:ad-reward-modal|watch-ad-reward-modal|millionaire-plan-excitation-modal)\/template\.js - reject

# 电商广告卡/落地页链路，来自 ecom_mall_cards_noveldr 离线包与截图商品卡。
^https?:\/\/ad\.zijieapi\.com\/ - reject
^https?:\/\/ads(?:[35]-normal(?:-[a-z]{2})?)?\.zijieapi\.com\/ - reject
^https?:\/\/ecom\.snssdk\.com\/ - reject
^https?:\/\/(?:growth|isaas|doulite-mall)\.ecombdapi\.com\/ - reject
^https?:\/\/(?:mix|ffh)\.jinritemai\.com\/ - reject
^https?:\/\/lf-ecom-gr-sourcecdn\.bytegecko\.com\/ - reject
^https?:\/\/lf3-fe\.ecombdstatic\.com\/ - reject

# 小游戏广告承载页/激励卡片。覆盖 IMG_7392.PNG 中“打开微信小游戏”残留广告，以及 drlynx_monetize_game 离线/远程模板。
^https?:\/\/minigame(?:[35]-normal(?:-[a-z]{2})?)?\.zijieapi\.com\/ - reject
^https?:\/\/reading\.snssdk\.com\/reading_offline\/drlynx_monetize_game\/(?:game-[^\/]+-card|[^?#]*)\/ - reject
^https?:\/\/lf-fe\.fqnovelstatic\.com\/obj\/novel-fanqie-fe\/novel-dragon\/feoffline\/drlynx_monetize_game\/ - reject
^https?:\/\/(?:lf-sourcecdn-tos\.bytegecko\.com|lf-sourcecdn-tos\.bytegoofy\.com|tosv\.byted\.org)\/.*\/drlynx_monetize_game\/.*template\.js - reject

# 阅读器“看视频免广告”激励入口。只覆盖广告获取、评论广告上报与视频完成/任务完成回调，不拦 luckycat 钱包主接口。
^https?:\/\/api(?:[35]-normal(?:-[a-z]{2})?)?\.fqnovel\.com\/luckycat\/(?:novel|novel_fm)\/v1\/task\/get_ad_info - reject
^https?:\/\/api(?:[35]-normal(?:-[a-z]{2})?)?\.fqnovel\.com\/luckycat\/(?:novel|novel_fm)\/v[12]\/report\/ad_comment - reject
^https?:\/\/api(?:[35]-normal(?:-[a-z]{2})?)?\.fqnovel\.com\/luckycat\/(?:novel|novel_fm)\/v1\/task\/done\/[^\/?#]+ - reject

[Map Local]
# 启动 PCDN 设置空响应。
^https?:\/\/is\.snssdk\.com\/service\/settings\/v[23]\/?(?:\?.*)?$ data-type=text data="{\"settings\":{},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"

# Pangle/GroMore 空广告响应。保留请求完成语义，减少硬拒绝导致卡等待的概率。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:1|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/ data-type=text data="{\"request_id\":\"surge-no-ad\",\"status_code\":20001,\"reason\":141,\"desc\":\"no ad\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/setting\/ data-type=text data="{\"data\":{\"init_enable\":false,\"extra_settings\":{\"init_enable\":false,\"use_pangle_plugin\":false,\"enable_feed_no_ad\":true,\"ad_id\":{}}},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/v4\/ data-type=text data="{\"data\":{},\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"

# Kuaishou/KSAd 空广告响应。
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/univ data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"impAdInfo\":\"\",\"extra\":\"\",\"adGlobalConfigInfo\":\"\",\"hasAd\":false}" status-code=200 header="Content-Type:application/json"
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/rest\/e\/v3\/open\/logBatch data-type=text data="{\"llsid\":0,\"result\":1,\"errorMsg\":\"OK\",\"hasMore\":false,\"interval\":3600}" status-code=200 header="Content-Type:application/json"

# JSON/HTML 型 SDK 空广告响应。
^https?:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg data-type=text data="{\"ret\":0,\"msg\":\"\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mobads\.baidu\.com\/cpro\/ui\/mads\.php data-type=text data="<html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body></body></html>" status-code=200 header="Content-Type:text/html; charset=utf-8"
^https?:\/\/api\.qttunion\.com\/v5\/json data-type=text data="{\"code\":0,\"data\":{\"ads\":[]},\"msg\":\"ok\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/service\.qttunion\.com\/qmcd\/get data-type=text data="{\"code\":0,\"data\":[],\"msg\":\"ok\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/cpc-service-square\.aiclk\.com\/v1\/getConfig data-type=text data="{\"code\":0,\"data\":{}}" status-code=200 header="Content-Type:application/json"
