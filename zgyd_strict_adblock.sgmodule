#!name=中国移动 zgyd 严格去广告
#!desc=基于中国移动 12.1.2 IPA、2026-06-25/26 多份 HAR 生成。v21 在 v20 本机关闭端口方案上补强 127.0.0.1/localhost 直连，避免被全局 SUBNET 代理接管后继续等待 10 秒。
#!author=Claude
#!homepage=https://www.10086.cn/
#!date=2026-06-26
#!version=21

[General]
force-http-engine-hosts = %APPEND% client.app.coc.10086.cn
skip-proxy = %APPEND% 127.0.0.1, localhost, ::1

[URL Rewrite]
# ===== HAR 证据：明确日志/埋点/统计/上报 =====
^https?:\/\/da\.mmarket\.com\/udata_v5\/appsdk\/postsyslog - reject
^https?:\/\/dualstack-logs\.amap\.com\/ws\/log\/upload - reject
^https?:\/\/logs\.amap\.com\/ws\/log\/upload - reject
^https?:\/\/api\.share\.mob\.com\/(snsconf|conf5) - reject
^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaidcsdkserver\/dataReported\/resultReportedMaster - reject
^https?:\/\/apm\.app\.coc\.10086\.cn\/biz-orange\/DH\/(switch\/getServiceSwitch|footmark\/openPro) - reject

# ===== HAR 证据：推送、消息、已读回执、营销消息 =====
^https?:\/\/push\.it\.10086\.cn\/(mc|contact)\/(pull|receipt|device)\/.* - reject

# ===== HAR 证据：弹窗、toast、挽留、浮窗、运营页 =====
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/toast\/(getToastRule|getDelayTime) - reject
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DH\/toast\/august\/getPages - reject
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/detainment\/august\/getPages - reject
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DA\/liveSuspension\/getPageCode - reject

# ===== v21：开屏大配置改由脚本快速本机拒绝 =====
# 06:21 HAR 中 homepagePopup/getSortInfo、searchWord、homeSkin、hotupdate 均在开屏回流时 200 返回；v8 对这些运营入口拦截时可压住开屏。
# 17:23 HAR 证明 v17 硬断开这些请求后仍有广告；v10 有效差异是 reject-dict，让 App 收到失败字典而非走网络失败兜底。
# 17:32 HAR 证明 reject-dict 会被 Surge 当成 URL 改写目标并等待 10 秒；17:37 HAR 证明脚本直接 HTTP 503 不压制开屏。
# 18:21 HAR 证明 v20 脚本已命中，但 127.0.0.1:9 被 SUBNET 代理到 192.168.0.100 后仍等待 10 秒。
# v21 保留脚本重写，并在 Rule 层强制本机地址 DIRECT。
# qwhdcdn 仅保留带明确广告/弹窗语义的路径拦截，不再按 prd-mgcenter 整目录拦截。
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/(dataReport\/getSwitchSetupInformation|third\/getThirdUrlList) - reject
^https?:\/\/qwhdcdn\.cmcc-cs\.cn\/.*\/(banner|popup|ad|ads|advert|activity|marketing|promotion|recommend).* - reject-img

# ===== IPA 证据：智能推荐/灰度/规则/模型/运营开关，严格拦截 =====
^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaiddsdkserver\/(merger\/getFeatureAndInferRule|feature\/getOfflineFeature|switch\/productInfoV2LogicEnable|merger\/getSwitchAndInitList|model\/getConfigInfoUrl\.json).* - reject
^https?:\/\/h\.app\.coc\.10086\.cn(?::443)?\/ngpsie\/psieipuudp\/appInfo\/checkAppInfo - reject

# ===== IPA/HAR 证据：咪咕视频广告/推荐/灰度/日志 =====
^https?:\/\/(dsp\.aikan|logs\.aikan|vodother\.aikan|liveother\.aikan)\.miguvideo\.com.* - reject
^https?:\/\/kdds-ad\.zj\.chinamobile\.com.* - reject
^https?:\/\/sspcloud\.huawei\.com.* - reject
^https?:\/\/v\.miguvideo\.com\/mrule\/v1\/gray-info.* - reject
^https?:\/\/aikanvod\.miguvideo\.com\/video\/p\/(recoVideoShare|AC_limitFreePage|AC_AiQiYiBag|filterContentList|openAppMiddlePage).* - reject

# ===== 新 HAR 2026-06-25 13:48/14:02/14:48 证据：开屏/弹窗策略引擎 =====
# v5 调整：14:48 HAR 证明 v4 放行 psieappaijssdk/engine 后开屏广告回流。
# 重新拦截中国移动自己的策略引擎 JS；DN/init 启动初始化后续快速拒绝，避免放回或缓存兜底开屏广告配置。
^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaijssdk\/engine\/(candidateStrategyRule|diyProductInfoStrategys|ruleEngine|strategyWeightEngine|diyEngine)\/.*-index\.js - reject
^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaijssdk\/engine\/index\.html - reject
^https?:\/\/h\.app\.coc\.10086\.cn(?::443)?\/ngpsie\/psieipuudp\/gather\/newSendLogForAES - reject

# ===== v21：启动广告入口由脚本快速本机拒绝 =====
# IPA 中 10000 对应 DN/init/startInit，二进制存在 parseResponseIfContainLingXiLaunchADInfo/requestStartADInfo/CMCCStartAD*。
# v15-v17 的硬断开仍有开屏，v18 可压制但等待 10 秒；v19 明确 HTTP 503 不够，需模拟网络层失败。

# ===== 第三方统计/广告 SDK 兜底 =====
# v4 兼容性调整：移除全网通配 /ad|splash|banner|log/ 拦截，避免覆盖七猫等其它 App 模块的 Map Local / DIRECT 逻辑。
# 仅保留在中国移动 HAR/IPA 中明确出现的第三方统计域名。
^https?:\/\/api\.mixpanel\.com\/track\/.* - reject
^https?:\/\/webhooks\.mongodb-realm\.com\/api\/client\/v2\.0\/app\/realmsdkmetrics-.* - reject

[Map Local]
# v16：消息/埋点类接口仍用空 JSON 快速完成，避免 URL Rewrite reject/reject-dict 在 06:37 HAR 中等待 10 秒后 503。
^https?:\/\/client\.app\.coc\.10086\.cn\/cache_server\/api\/cache\/encrypt\/reportV2 data-type=text data="{}" status-code=200
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/UN\/message\/pushMessage data-type=text data="{}" status-code=200
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DH\/msg\/ph\/(config\/select|config\/selectConfig|unReadTotal) data-type=text data="{}" status-code=200
^https?:\/\/jiguang\.coc\.10086\.cn\/v3\/projects\/9e4e5fa7244c6b6e\/(collect|query).* data-type=text data="{}" status-code=200
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DH\/sdkPlug\/getSdkList data-type=text data="{}" status-code=200

[Script]
uBO ZGYD Startup Config Fast Refused = type=http-request, pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homepagePopup\/getSortInfo|searchWord\/getSearchWordInfo|multipleInterfaces\/aggregationData|homePage\/getTopAreaList|init\/(?:getNavigation|startInit))|DH\/(?:homeSkin\/getHomeSkin|hotupdate\/getHotupdateList)|BN\/sscrz\/getProvSwitchConf)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/zgyd-startup-ad-clean.js?v=zgyd-v21-1, script-update-interval=86400, timeout=2, engine=jsc

[Rule]
# v21：脚本把启动广告配置重写到本机关闭端口；必须直连，否则会被总配置 SUBNET 代理接管并继续等待 10 秒。
DOMAIN,localhost,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve

# 明确广告/统计域名，域名级拒绝
DOMAIN,da.mmarket.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
DOMAIN,logs.amap.com,REJECT
DOMAIN,api.share.mob.com,REJECT
DOMAIN,api.mixpanel.com,REJECT
DOMAIN,dsp.aikan.miguvideo.com,REJECT
DOMAIN,logs.aikan.miguvideo.com,REJECT
DOMAIN,kdds-ad.zj.chinamobile.com,REJECT
DOMAIN,sspcloud.huawei.com,REJECT
# v9：不再整域拦截 jiguang / apm / push，避免正面消息、我的页、活动状态等接口被域名级误伤；改由下方 URL-REGEX 精准拦截 collect/receipt/pull 等链路。
# v4 兼容性调整：不再整域拦截 Umeng/Bugly，也不使用 DOMAIN-KEYWORD tracking/adservice/advert。
# 七猫模块明确把 Umeng/Bugly/部分 SDK 状态链路作为非广告/功能链路处理；全局拒绝会让七猫模块失效。

DOMAIN-SUFFIX,mmarket.com,REJECT

# v21 补强：只在中国移动域名范围内做 URL-REGEX 预匹配，避免恢复会影响七猫模块的全网通配规则。
# 注意：首页核心大配置不放在 Rule 层 REJECT，否则会重新造成 06:37 这类页面内刷新等待。
# 先放行更偏功能/账户/白名单/页面刷新查询的接口，避免把正面信息一起挡掉；不要把 v16 已处理的开屏大配置放进 DIRECT。
URL-REGEX,^https?:\/\/client\.app\.coc\.10086\.cn\/(biz-orange\/(DN\/(openplatform\/clientPermissionInfo|webCache\/cacheCleanUp|call\/cson\/meet\/sdk\/getSignature|careVersion\/filialPietyCard|protocol\/getProtocolHeaders|myPageNew\/getMyPageNew|mypage\/getMyPageWaterFall|headPhoto\/photoConfig|refreshSession|scanIt\/getScanItWhiteList|urlWhite\/getUrlWhiteList)|LN\/(checkUIDAction\/checkUID|uamrandcodelogin\/autoLogin)|SHG\/(querytid\/getTid|meterAssets\/query|myPage\/getMembershipInfo|codeTable\/(getHomeCodeTableList|getPointConfiqUration))|SHS\/unifiedSearch\/secondMonitorControl|v1\/SHE\/unused\/query|WN\/mailService\/getUnreadCount|DH\/deployEnvironment\/getSignList|MPCA\/account\/getAppletPreloadInfo)|ServiceControl\/SC\/(versionWhites|secret\/getSecretSecurityConfig)|leadeon-abilityopen-biz\/BN\/(obtainToken\/getBigNetToken|ByToken\/multi)),DIRECT,extended-matching,pre-matching
URL-REGEX,^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaijssdk\/engine\/(candidateStrategyRule|diyProductInfoStrategys|ruleEngine|strategyWeightEngine|diyEngine)\/.*-index\.js,REJECT,extended-matching,pre-matching
URL-REGEX,^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaijssdk\/engine\/index\.html,REJECT,extended-matching,pre-matching
URL-REGEX,^https?:\/\/h\.app\.coc\.10086\.cn(?::443)?\/ngpsie\/psieipuudp\/(appInfo\/checkAppInfo|gather\/newSendLogForAES),REJECT,extended-matching,pre-matching
URL-REGEX,^https?:\/\/h\.app\.coc\.10086\.cn\/ngpsie\/psieappaiddsdkserver\/(merger\/getFeatureAndInferRule|feature\/getOfflineFeature|switch\/productInfoV2LogicEnable|merger\/getSwitchAndInitList|model\/getConfigInfoUrl\.json).*,REJECT,extended-matching,pre-matching
URL-REGEX,^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(DN\/(toast\/(getToastRule|getDelayTime)|detainment\/august\/getPages)|DH\/toast\/august\/getPages|DA\/liveSuspension\/getPageCode),REJECT,extended-matching,pre-matching
# v9：res.app.coc.10086.cn/prd-mgcenter 可能是正面运营图，先不做 Rule 层整目录 REJECT。

[MITM]
hostname = %APPEND% da.mmarket.com, dualstack-logs.amap.com, logs.amap.com, api.share.mob.com, client.app.coc.10086.cn, clientaccess.10086.cn, h.app.coc.10086.cn, apm.app.coc.10086.cn, push.it.10086.cn, jiguang.coc.10086.cn, res.app.coc.10086.cn, qwhdcdn.cmcc-cs.cn, mgsv.miguvideo.com, api.miguvideo.com, v.miguvideo.com, aikanvod.miguvideo.com, dsp.aikan.miguvideo.com, logs.aikan.miguvideo.com, kdds-ad.zj.chinamobile.com, sspcloud.huawei.com, api.mixpanel.com, webhooks.mongodb-realm.com
