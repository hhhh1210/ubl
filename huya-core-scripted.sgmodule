#!name=Huya iOS Ad Clean Lite for Surge
#!desc=虎牙直播 iOS 13.3.40 轻量去广告模块。基于 2026-06-17 17:01/17:17 HAR，仅处理最新捕获中明确出现的穿山甲/字节/火山/GDT/AMS/虎牙商业化素材、埋点接口与启动弹窗；保留播放、HTTPDNS、登录和 QQ SDK 配置。

[General]
force-http-engine-hosts = %APPEND% api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, mssdk.volces.com, toblog.ctobsnssdk.com, sdkreport.e.qq.com, tangram.e.qq.com, business.msstatic.com, fileserver.cdn.huya.com, statwup.huya.com, wsapi.huya.com, udbdf.huya.com, cloud.tgpa.qq.com, diy-front.cdn.huya.com

[Rule]
# Latest HAR observed third-party ad SDK / report endpoints: Pangle/CSJ, ByteDance AppLog, Volcengine MSSDK and GDT report.
URL-REGEX,^https?:\/\/(?:api-access\.pangolin-sdk-toutiao1?\.com\/api\/ad\/union\/sdk\/(?:settings|stats\/batch)|mssdk\.volces\.com\/ri\/report_otob|toblog\.ctobsnssdk\.com\/service\/2\/device_register_only\/|sdkreport\.e\.qq\.com\/link_event)(?:[?#/]|$),REJECT
# Latest HAR observed Huya/TGPA telemetry and fingerprint reports. Keep cdn.wup.huya.com and cgi.connect.qq.com allowed.
URL-REGEX,^https?:\/\/(?:statwup\.huya\.com\/(?:[?#]|$)|wsapi\.huya\.com\/(?:[?#]|$)|udbdf\.huya\.com\/device\/fingerprint\/log|cloud\.tgpa\.qq\.com\/cloudctrl\/cloud_ctrl)(?:[?#/]|$),REJECT
[Script]
# Keep only the response rewrite still observed as useful in the latest HAR: GDT updateSetting returns a no-ad SDK config.
uBO Huya iOS GDT Setting Clean = type=http-response, pattern=^https?:\/\/tangram\.e\.qq\.com\/updateSetting(?:\?.*)?$, script-path=https://raw.githubusercontent.com/hhhh1210/ubl/ios/huya-core-scripted.js?v=huya-core-scripted-20260617-2, script-update-interval=86400, argument=phase=gdt-setting, requires-body=true, max-size=131072, timeout=5, engine=jsc

[MITM]
hostname = %APPEND% api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, mssdk.volces.com, toblog.ctobsnssdk.com, sdkreport.e.qq.com, tangram.e.qq.com, business.msstatic.com, fileserver.cdn.huya.com, statwup.huya.com, wsapi.huya.com, udbdf.huya.com, cloud.tgpa.qq.com, diy-front.cdn.huya.com

[Map Local]
# AMS config, latest HAR observed startup popup payload, and Huya commercial image fallbacks.
^https?:\/\/business\.msstatic\.com\/dsp\/public\/sdkconfig\.xml(?:\?.*)?$ data-type=text data="<?xml version=\"1.0\" encoding=\"UTF-8\"?><config><offlineCache><length>0</length></offlineCache><companies></companies></config>" status-code=200 header="Content-Type:text/xml; charset=utf-8"
^https?:\/\/diy-front\.cdn\.huya\.com\/zt\/frontpage\/16\/huyaprivacy2\.html(?:\?.*)?$ data-type=text data="{\"need_show_dialog\":\"0\",\"key_privacy_window_content\":\"\",\"keyword\":\"\",\"clickurl\":\"\"}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?:\/\/fileserver\.cdn\.huya\.com\/ladder_app_navigate\/[a-f0-9]{32}\.png(?:\?.*)?$ data-type=tiny-gif status-code=200
^https?:\/\/fileserver\.cdn\.huya\.com\/ladder_normalUpload\/(?:160076e8203549a88c95cd670da1a876|7c86fdb01ffd41c19651e19338c67de0|995ba281e6e2470c9448182cc715dbf9|985b76e646a74f5686225c4de3bf1e6a|67d77b530925468cb6ca67c7f3f122ce|c7a8734dd38a482288606eed0824d65f)\.png(?:\?.*)?$ data-type=tiny-gif status-code=200
