#!name=Huya iOS Ad Clean Lite for Surge
#!desc=虎牙直播 iOS 13.3.x-13.4.20 稳定去广告模块。按 Surge iOS 5.9+ 脚本文档收敛为请求阶段 no-fill 与精确 Map Local，避免响应正文缓冲、共享 SDK 过度屏蔽及 Network Extension 内存压力。

[General]
force-http-engine-hosts = %APPEND% tangram.e.qq.com, us.l.qq.com, api-access.pangolin-sdk-toutiao.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, kiwistatic.huya.com

[Script]
# Only the two Huya-marked request paths execute JavaScript. All failures pass through unchanged.
uBO Huya iOS GDT Setting Request Clean = type=http-request, pattern=^https?:\/\/tangram\.e\.qq\.com\/updateSetting(?:\?.*)?$, script-path=https://raw.githubusercontent.com/hhhh1210/ubl/34aca2184b1358566ebb906df1d095ed703b7123/huya-core-scripted.js, script-update-interval=86400, argument=phase=gdt-setting-request, requires-body=true, max-size=16384, timeout=5, engine=jsc
uBO Huya iOS GDT Exapp Request NoFill = type=http-request, pattern=^https?:\/\/us\.l\.qq\.com\/exapp(?:\?.*)?$, script-path=https://raw.githubusercontent.com/hhhh1210/ubl/34aca2184b1358566ebb906df1d095ed703b7123/huya-core-scripted.js, script-update-interval=86400, argument=phase=gdt-exapp-request, timeout=5, engine=jsc

[MITM]
hostname = %APPEND% tangram.e.qq.com, us.l.qq.com, api-access.pangolin-sdk-toutiao.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, kiwistatic.huya.com

[Map Local]
# Exact startup control responses only; ordinary telemetry, SDK reports, app APIs and CDN assets pass through.
^https?:\/\/kiwistatic\.huya\.com\/kiwi_lizard\/LaunchAlert\/7\/LaunchAlert\.ios\.lzc(?:\?.*)?$ data-type=text data="" status-code=204
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/settings\/\?(?:[^#]*&)?aid=5000546(?:&|$) data-type=text data="{\"code\":20000,\"message\":\"success\",\"data\":{},\"settings\":{},\"ad_slot_conf_list\":[]}" status-code=200 header="Content-Type:application/json; charset=utf-8"
^https?:\/\/sf[36]-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/renderer\/package\.json\?(?:[^#]*&)?aid=5000546(?:&|$) data-type=text data="{\"resources\":[],\"templates\":[],\"data\":{},\"code\":0,\"message\":\"success\"}" status-code=200 header="Content-Type:application/json; charset=utf-8"
